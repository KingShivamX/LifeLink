# Environment Configuration Example
# Copy this file to .env and update values

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb+srv://shivamhippalgave_db_user:ee8jd4FBOzPqLoUv@cluster0.gwufynq.mongodb.net/lifelink?retryWrites=true&w=majority&appName=Cluster0

# Security
JWT_SECRET=lifelink_secret_key_2025_production_ready
JWT_EXPIRES_IN=7d

# Email Configuration (Optional)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# SMS Configuration (Optional - Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (Production)
ALLOWED_ORIGINS=http://localhost:3000,https://lifelink.health
