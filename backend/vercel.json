{
    "version": 2,
    "functions": {
        "api/index.js": {
            "runtime": "vercel/node@20.x",
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "installCommand": "npm install",
    "buildCommand": "npm install",
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.js"
        }
    ]
}
